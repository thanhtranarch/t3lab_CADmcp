<Project>
  <!-- Shared settings for the AutoCAD add-in projects.
       One build per AutoCAD API series (binary compatible inside a series):
         R24  AutoCAD / Civil 3D 2022-2024   .NET Framework 4.8   AutoCAD.NET 24.1
         R25  AutoCAD / Civil 3D 2025-2026   .NET 8               AutoCAD.NET 25.0
         R26  AutoCAD / Civil 3D 2027        .NET 10              AutoCAD.NET 26.0
       dotnet build -p:AcadSeries=R25   (default R24). The AutoCAD API comes from
       Autodesk's NuGet packages, so no AutoCAD install is needed to build any series.
       Output: bin\Release\<series>\ -->
  <PropertyGroup>
    <AcadSeries Condition="'$(AcadSeries)' == ''">R24</AcadSeries>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <DebugType>full</DebugType>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>bin\$(Configuration)\$(AcadSeries)\</OutputPath>
    <!-- Outside the project folders: per-series obj dirs would otherwise be compiled by the default globs. -->
    <BaseIntermediateOutputPath>$(MSBuildThisFileDirectory)..\obj\$(MSBuildProjectName)\$(AcadSeries)\</BaseIntermediateOutputPath>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Version>1.1.1</Version>
    <Company>T3Lab</Company>
    <Product>T3Lab CAD MCP</Product>
    <Copyright>T3Lab</Copyright>
  </PropertyGroup>

  <PropertyGroup Condition="'$(AcadSeries)' == 'R24'">
    <TargetFramework>net48</TargetFramework>
    <AcadNetVersion>24.1.51000</AcadNetVersion>
  </PropertyGroup>
  <PropertyGroup Condition="'$(AcadSeries)' == 'R25'">
    <TargetFramework>net8.0-windows</TargetFramework>
    <AcadNetVersion>25.0.1</AcadNetVersion>
  </PropertyGroup>
  <PropertyGroup Condition="'$(AcadSeries)' == 'R26'">
    <TargetFramework>net10.0-windows</TargetFramework>
    <AcadNetVersion>26.0.0</AcadNetVersion>
  </PropertyGroup>
  <PropertyGroup Condition="'$(TargetFramework)' != 'net48'">
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <!-- AutoCAD .NET 8+ add-ins load in AutoCAD's own context: no deps.json probing. -->
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <EnableDynamicLoading>true</EnableDynamicLoading>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <!-- net48 reference assemblies, so no Visual Studio targeting pack is needed. -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- Compile against AutoCAD's API only; AutoCAD supplies the DLLs at run time. -->
    <PackageReference Include="AutoCAD.NET" Version="$(AcadNetVersion)" ExcludeAssets="runtime" PrivateAssets="all" />
  </ItemGroup>
</Project>
