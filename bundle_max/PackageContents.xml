<?xml version="1.0" encoding="utf-8"?>
<!-- 3ds Max package manifest. MCP Control's Connect in T3Lab (or scripts/install_max.ps1) puts this
     folder at %APPDATA%\Autodesk\ApplicationPlugins\T3LabMax.bundle; 3ds Max 2022-2027 runs the
     start-up script below after it starts (Python 3.7+ through pymxs, no compiled parts). -->
<ApplicationPackage SchemaVersion="1.0"
                    AutodeskProduct="3ds Max"
                    ProductType="Application"
                    Name="T3Lab 3ds Max MCP"
                    Description="MCP server inside 3ds Max: lets Claude read and edit the open scene."
                    AppVersion="1.1.0"
                    Author="T3Lab"
                    ProductCode="{5227CDA0-56D0-4CE4-93DC-96B78FBF7459}"
                    UpgradeCode="{0C927160-B3AB-46CD-940C-0034B7395155}">
  <CompanyDetails Name="T3Lab" />
  <Components Description="post-start-up scripts parts">
    <RuntimeRequirements OS="Win64" Platform="3ds Max" SeriesMin="2022" SeriesMax="2027" />
    <ComponentEntry AppName="T3LabMax"
                    Version="1.1.0"
                    ModuleName="./Contents/scripts/t3lab_max_mcp_start.ms"
                    AppDescription="Starts the T3Lab MCP server (127.0.0.1:48910-48918)" />
  </Components>
</ApplicationPackage>
